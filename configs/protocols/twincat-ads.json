{
  "schemaVersion": 2,
  "protocolName": "twincat-ads",
  "transport": { "type": "Tcp", "defaultPort": 48898 },
  "framing": {
    "type": "LengthField",
    "lengthFieldOffset": 2,
    "lengthFieldLength": 4,
    "lengthIncludesHeader": false,
    "byteOrder": "LittleEndian",
    "headerLength": 6,
    "lengthAdjustment": 0,
    "maxFrameSize": 8192
  },
  "dataByteOrder": "LittleEndian",
  "inputs": {
    "StartByteAddress": { "source": "static", "value": 0, "label": "IndexOffset (按设备符号映射, 字节)", "unit": "字节" },
    "ByteCount": { "source": "static", "value": 2, "label": "读取字节长度", "unit": "字节" },
    "NetIdLo": { "source": "static", "value": 65793, "label": "NetId 低 32 位 0x00010101 (IP 后两段 .1.1 + 主机段)", "unit": "打包" },
    "NetIdHi": { "source": "static", "value": 49320, "label": "NetId 高 16 位 0xC0A8 (IP 前两段 192.168)", "unit": "打包" },
    "TargetPort": { "source": "static", "value": 801, "label": "目标端口 0x321 (PLC 运行时)" },
    
    "SourcePort": { "source": "static", "value": 22880, "label": "源端口 0x5960 (任意高位端口)" },
    "CmdId": { "source": "static", "value": 2, "label": "命令 ID 0x0002 (ADS Read)" },
    "StateFlags": { "source": "static", "value": 4, "label": "状态 0x04 (Request)" },
    "DataLen": { "source": "static", "value": 12, "label": "数据长度 (读请求 = IndexGroup/Offset/Length 3x4B)" },
    "ErrorInfo": { "source": "static", "value": 0, "label": "错误码 (请求恒 0)" },
    "InvokeIDSeed": { "source": "auto", "strategy": "autoIncrement", "params": { "seed": 1 }, "label": "调用 ID (每次请求递增)" },
    "IndexGroup": { "source": "static", "value": 61441, "label": "0xF005 (READ_Mx 标志区)" }
  },
  "operations": {
    "ReadByOffset": {
      "kind": "read",
      "requestTemplate": [
        "00 00", "{AdmLen:X8LE}",
        "{NetIdLo:X8LE}", "{NetIdHi:X4LE}", "{TargetPort:X4LE}",
        "{NetIdLo:X8LE}", "{NetIdHi:X4LE}", "{SourcePort:X4LE}",
        "{CmdId:X4LE}", "{StateFlags:X4LE}",
        "{DataLen:X8LE}", "{ErrorInfo:X8LE}", "{InvokeIDSeed:X8LE}",
        "{IndexGroup:X8LE}", "{StartByteAddress:X8LE}", "{ByteCount:X8LE}"
      ],
      "inputs": {},
      "outputs": {
        "AdmLen": { "source": "auto", "strategy": "derivedLength", "expr": "{Frame:fixed} - 6", "label": "AMS 报文长 = 帧长 - 6 (reserved 2B + 长度域 4B 之外的全部)" }
      },
      "responseParser": {
        "validCondition": "resp[38] == 0",
        "dataStartIndex": 46,
        "dataLengthExpr": ""
      }
    }
  },
  "handshake": []
}
