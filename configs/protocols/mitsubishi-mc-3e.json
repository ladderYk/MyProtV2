{
  "schemaVersion": 2,
  "protocolName": "mitsubishi-mc-3e",
  "transport": { "type": "Tcp", "defaultPort": 5007 },
  "framing": {
    "type": "LengthField",
    "lengthFieldOffset": 0,
    "lengthFieldLength": 2,
    "lengthIncludesHeader": false,
    "byteOrder": "LittleEndian",
    "headerLength": 0,
    "lengthAdjustment": 0,
    "maxFrameSize": 2048
  },
  "dataByteOrder": "WordLittleByteBig",
  "inputs": {
    "StartByteAddress": { "source": "static", "value": 0, "label": "D 寄存器字节地址 (字元件, 1 字 = 2 字节)", "unit": "字节" },
    "ByteCount": { "source": "static", "value": 2, "label": "数据字节跨度", "unit": "字节" },
    "NetNo": { "source": "static", "value": 0, "label": "网络编号 0x00" },
    "PCNo": { "source": "static", "value": 255, "label": "PC 编号 0xFF" },
    "ReqDestIO": { "source": "static", "value": 0, "label": "请求目标模块 I/O 0x0000 (CPU)" },
    "ReqDestSta": { "source": "static", "value": 0, "label": "请求目标站 0x00" },
    "DevCodeD": { "source": "static", "value": 168, "label": "D 寄存器设备码 0xA8" },
    "SubCmd": { "source": "static", "value": 0, "label": "副命令 0x0000" }
  },
  "operations": {
    "ReadDRegisters": {
      "kind": "read",
      "requestTemplate": [
        "C5", "C5",
        "{NetNo:X2}", "{PCNo:X2}", "{ReqDestIO:X4}", "{ReqDestSta:X2}",
        "{WatchHi:X2}", "{WatchLo:X2}",
        "01", "04",
        "{SubCmdLo:X2}", "{SubCmdHi:X2}",
        "{DevCodeD:X2}",
        "{HeadDevLo16:X4}", "{HeadDevHi8:X2}",
        "{DevCountRev2:X4}"
      ],
      "inputs": {},
      "outputs": {
        "WatchHi": { "source": "auto", "strategy": "derivedLength", "expr": "1600 / 256 % 256", "label": "监视定时器高字节 (小端值需反转)" },
        "WatchLo": { "source": "auto", "strategy": "derivedLength", "expr": "1600 % 256", "label": "监视定时器低字节 (小端值需反转)" },
        "SubCmdLo": { "source": "auto", "strategy": "derivedLength", "expr": "0 % 256", "label": "副命令低字节" },
        "SubCmdHi": { "source": "auto", "strategy": "derivedLength", "expr": "0 / 256 % 256", "label": "副命令高字节" },
        "HeadDevLo16": { "source": "auto", "strategy": "derivedLength", "expr": "StartByteAddress / 2 % 256 * 256 + (StartByteAddress / 2 / 256 % 256)", "label": "头软元件号低 2 字节 (小端合成)" },
        "HeadDevHi8": { "source": "auto", "strategy": "derivedLength", "expr": "StartByteAddress / 2 / 65536 % 256", "label": "头软元件号最高字节 (D 区恒 0)" },
        "DevCountRev2": { "source": "auto", "strategy": "derivedLength", "expr": "ByteCount / 2 % 256 * 256 + (ByteCount / 2 / 256 % 256)", "label": "点数 2 字节小端合成" }
      },
      "responseParser": {
        "validCondition": "resp[9] == 0",
        "dataStartIndex": 11,
        "dataLengthExpr": ""
      }
    }
  },
  "handshake": []
}
