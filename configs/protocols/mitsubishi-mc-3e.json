{
  "schemaVersion": 2,
  "protocolName": "mitsubishi-mc-3e",
  "transport": { "type": "Tcp", "defaultPort": 5007 },
  "framing": {
    "type": "LengthField",
    "lengthFieldOffset": 7,
    "lengthFieldLength": 2,
    "lengthIncludesHeader": false,
    "byteOrder": "LittleEndian",
    "headerLength": 9,
    "lengthAdjustment": 0,
    "maxFrameSize": 2048
  },
  "dataByteOrder": "WordLittleByteBig",
  "inputs": {
    "StartByteAddress": { "source": "static", "value": 0, "label": "D 寄存器字节地址 (字元件, 1 字 = 2 字节)", "unit": "字节" },
    "ByteCount": { "source": "static", "value": 2, "label": "数据字节跨度", "unit": "字节" },
    "NetNo": { "source": "static", "value": 0, "label": "网络编号 0x00" },
    "PCNo": { "source": "static", "value": 255, "label": "PC 编号 0xFF" },
    "ReqDestIO": { "source": "static", "value": 0, "label": "请求目标模块 I/O 0x0000 (CPU)" },
    "ReqDestSta": { "source": "static", "value": 0, "label": "请求目标站 0x00" },
    "Watchdog": { "source": "static", "value": 1600, "label": "监视定时器 0x0640 (250ms 仕様; 0 = 不监视)" },
    "DevCodeD": { "source": "static", "value": 168, "label": "D 寄存器设备码 0xA8" },
    "SubCmd": { "source": "static", "value": 0, "label": "副命令 0x0000" }
  },
  "operations": {
    "ReadDRegisters": {
      "kind": "read",
      "requestTemplate": [
        "50", "00",
        "{NetNo:X2}", "{PCNo:X2}", "{ReqDestIO:X4LE}", "{ReqDestSta:X2}",
        "{ReqDataLen:X4LE}",
        "{Watchdog:X4LE}",
        "01", "04",
        "{SubCmd:X4LE}",
        "{DevCodeD:X2}",
        "{HeadDev:X6LE}",
        "{Points:X4LE}"
      ],
      "inputs": {},
      "outputs": {
        "HeadDev": { "source": "auto", "strategy": "derivedLength", "expr": "StartByteAddress / 2", "label": "头软元件号 (D 区字地址)" },
        "ReqDataLen": { "source": "auto", "strategy": "derivedLength", "expr": "{Frame:fixed} - 9", "label": "请求数据长 (监视定时器起至帧尾 = 帧长 - 9)" },
        "Points": { "source": "auto", "strategy": "derivedLength", "expr": "ByteCount / 2", "label": "点数 (字)" }
      },
      "responseParser": {
        "validCondition": "resp[9] == 0",
        "dataStartIndex": 11,
        "dataLengthExpr": ""
      }
    }
  },
  "handshake": []
}
