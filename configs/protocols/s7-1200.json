          "unit": "字节"
        },
        "DataBits": {
          "source": "auto",
          "strategy": "derivedLength",
          "expr": "{WriteValue:len} * 8",
          "label": "位长度",
          "unit": "bit"
        }
      },
      "responseParser": {
        "validCondition": "resp[21] == 0xFF",
        "dataStartIndex": 25,
        "dataLengthExpr": ""
      }
    },
    "WriteVarDWord": {
      "kind": "write",
