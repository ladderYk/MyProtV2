          "expr": "(StartByteAddress * 8) / 65536",
          "label": "S7 地址高字节"
        },
        "ItemLength": {
          "source": "auto",
          "strategy": "derivedLength",
          "expr": "ByteCount / 2",
          "label": "元素数 (WORD)",
          "unit": "个"
        },
        "PDULength": {
          "source": "auto",
          "strategy": "derivedLength",
          "expr": "{Frame:fixed} + {WriteValue:len}",
          "label": "PDU 长度（TPKT 总帧长）"
        },
        "DataLen": {
          "source": "auto",
