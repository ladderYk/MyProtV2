          "label": "REAL 元素数量",
          "unit": "个"
        }
      },
      "responseParser": {
        "validCondition": "resp[21] == 0xFF",
        "dataStartIndex": 25,
        "dataLengthExpr": ""
      }
    },
    "WriteVarBit": {
      "kind": "write",
      "requestTemplate": [
        "03 00",
        "{PDULength:X4}",
        "02 F0 80",
        "32 01 00 00",
        "{TransactionID:X4}",
        "00 0E",
        "{DataLen:X4}",
        "05 01",
        "12 0A 10",
        "01",
        "00 01",
        "{DBNumber:X4}",
        "{Area:X2}",
        "{AddrHi:X2}",
        "{AddrMid:X2}",
        "{AddrLo:X2}",
        "00",
        "03",
        "00 01",
        "{WriteValue:raw}"
      ],
      "inputs": {
        "WriteValue": {
          "source": "static",
          "label": "写入载荷 (1 字节 0/1)"
        }
      },
      "outputs": {
        "AddrLo": {
          "source": "auto",
          "strategy": "derivedLength",
          "expr": "(StartByteAddress * 8 + BitOffset) % 256",
          "label": "S7 地址低字节",
          "unit": "位寻址 = 字节地址<<3 + 位偏移"
        },
        "AddrMid": {
          "source": "auto",
          "strategy": "derivedLength",
          "expr": "((StartByteAddress * 8 + BitOffset) / 256) % 256",
          "label": "S7 地址中字节"
        },
        "AddrHi": {
          "source": "auto",
          "strategy": "derivedLength",
          "expr": "(StartByteAddress * 8 + BitOffset) / 65536",
          "label": "S7 地址高字节"
        },
        "PDULength": {
          "source": "auto",
          "strategy": "derivedLength",
          "expr": "{Frame:fixed} + {WriteValue:len}",
          "label": "PDU 长度（TPKT 总帧长）"
        },
        "DataLen": {
          "source": "auto",
          "strategy": "derivedLength",
          "expr": "{WriteValue:len} + 4",
          "label": "数据区总长",
          "unit": "字节"
        }
      },
      "responseParser": {
        "validCondition": "resp[21] == 0xFF",
        "dataStartIndex": 25,
        "dataLengthExpr": ""
      }
    },
    "WriteVarWord": {
      "kind": "write",
      "requestTemplate": [
        "03 00",
        "{PDULength:X4}",
        "02 F0 80",
        "32 01 00 00",
        "{TransactionID:X4}",
        "00 0E",
        "{DataLen:X4}",
        "05 01",
        "12 0A 10",
        "04",
        "{ItemLength:X4}",
        "{DBNumber:X4}",
        "{Area:X2}",
        "{AddrHi:X2}",
        "{AddrMid:X2}",
        "{AddrLo:X2}",
        "00",
        "04",
        "{DataBits:X4}",
        "{WriteValue:raw}"
      ],
      "inputs": {
        "WriteValue": {
          "source": "static",
          "label": "写入载荷"
        }
      },
      "outputs": {
        "AddrLo": {
          "source": "auto",
