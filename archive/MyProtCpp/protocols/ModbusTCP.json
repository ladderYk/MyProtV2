{
  "protocolName": "ModbusTCP",
  "transport": {
    "type": "Tcp",
    "defaultPort": 502
  },
  "framing": {
    "type": "LengthField",
    "lengthFieldOffset": 4,
    "lengthFieldLength": 2,
    "lengthIncludesHeader": false,
    "byteOrder": "BigEndian",
    "headerLength": 6
  },
  "connection": {
    "responseTimeoutMs": 1000,
    "interFrameDelayMs": 0,
    "reconnectIntervalMs": 5000,
    "maxReconnectAttempts": -1
  },
  "operations": {
    "ReadCoils": {
      "requestTemplate": [
        "{TransactionID:auto:X4}",
        "00 00",
        "{Length:calc:X4}",
        "{UnitID:X2}",
        "01",
        "{StartAddress:X4}",
        "{BitCount:X4}"
      ],
      "responseParser": {
        "validCondition": "resp[7] == 0x01",
        "dataStartIndex": 9,
        "dataLengthExpr": "resp[8]",
        "valueType": "ByteArray"
      }
    },
    "ReadDiscreteInputs": {
      "requestTemplate": [
        "{TransactionID:auto:X4}",
        "00 00",
        "{Length:calc:X4}",
        "{UnitID:X2}",
        "02",
        "{StartAddress:X4}",
        "{BitCount:X4}"
      ],
      "responseParser": {
        "validCondition": "resp[7] == 0x02",
        "dataStartIndex": 9,
        "dataLengthExpr": "resp[8]",
        "valueType": "ByteArray"
      }
    },
    "ReadHoldingRegisters": {
      "requestTemplate": [
        "{TransactionID:auto:X4}",
        "00 00",
        "{Length:calc:X4}",
        "{UnitID:X2}",
        "03",
        "{StartAddress:X4}",
        "{RegisterCount:X4}"
      ],
      "responseParser": {
        "validCondition": "resp[7] == 0x03",
        "dataStartIndex": 9,
        "dataLengthExpr": "resp[8]",
        "valueType": "ByteArray"
      }
    },
    "ReadInputRegisters": {
      "requestTemplate": [
        "{TransactionID:auto:X4}",
        "00 00",
        "{Length:calc:X4}",
        "{UnitID:X2}",
        "04",
        "{StartAddress:X4}",
        "{RegisterCount:X4}"
      ],
      "responseParser": {
        "validCondition": "resp[7] == 0x04",
        "dataStartIndex": 9,
        "dataLengthExpr": "resp[8]",
        "valueType": "ByteArray"
      }
    },
    "WriteSingleCoil": {
      "requestTemplate": [
        "{TransactionID:auto:X4}",
        "00 00",
        "{Length:calc:X4}",
        "{UnitID:X2}",
        "05",
        "{CoilAddress:X4}",
        "{Value:X4}"
      ],
      "responseParser": {
        "validCondition": "resp[7] == 0x05",
        "dataStartIndex": 0,
        "dataLengthExpr": "0",
        "valueType": "Empty"
      }
    },
    "WriteSingleRegister": {
      "requestTemplate": [
        "{TransactionID:auto:X4}",
        "00 00",
        "{Length:calc:X4}",
        "{UnitID:X2}",
        "06",
        "{RegisterAddress:X4}",
        "{Value:X4}"
      ],
      "responseParser": {
        "validCondition": "resp[7] == 0x06",
        "dataStartIndex": 0,
        "dataLengthExpr": "0",
        "valueType": "Empty"
      }
    },
    "WriteMultipleCoils": {
      "requestTemplate": [
        "{TransactionID:auto:X4}",
        "00 00",
        "{Length:calc:X4}",
        "{UnitID:X2}",
        "0F",
        "{StartAddress:X4}",
        "{BitCount:X4}",
        "{ByteCount:X2}",
        "{Values:X2}"
      ],
      "responseParser": {
        "validCondition": "resp[7] == 0x0F",
        "dataStartIndex": 0,
        "dataLengthExpr": "0",
        "valueType": "Empty"
      }
    },
    "WriteMultipleRegisters": {
      "requestTemplate": [
        "{TransactionID:auto:X4}",
        "00 00",
        "{Length:calc:X4}",
        "{UnitID:X2}",
        "10",
        "{StartAddress:X4}",
        "{RegisterCount:X4}",
        "{ByteCount:X2}",
        "{Values:X2}"
      ],
      "responseParser": {
        "validCondition": "resp[7] == 0x10",
        "dataStartIndex": 0,
        "dataLengthExpr": "0",
        "valueType": "Empty"
      }
    }
  }
}
